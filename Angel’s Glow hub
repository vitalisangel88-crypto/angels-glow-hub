<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Angels Glow Hub | Beauty & Accessories</title>
<style>
:root {
  --pink: #f05b9a;
  --light: #fff0f6;
  --dark: #402334;
  --white: #fff;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #fffafd;
  color: var(--dark);
}
header {
  padding: 25px 15px;
  text-align: center;
  background: linear-gradient(135deg,#ffd5e7,#fff0f6);
}
header h1 { margin: 0; color: #c62d76; }
header p { margin-bottom: 0; }
nav {
  background: white;
  padding: 14px;
  text-align: center;
  position: sticky;
  top: 0;
  box-shadow: 0 2px 8px #00000010;
}
nav a {
  color: #c62d76;
  margin: 0 12px;
  text-decoration: none;
  font-weight: bold;
}
.hero {
  padding: 45px 20px;
  text-align: center;
  background: var(--light);
}
button {
  background: var(--pink);
  color: white;
  border: none;
  padding: 12px 18px;
  border-radius: 25px;
  cursor: pointer;
  font-weight: bold;
}
button:hover { background: #d63b7e; }
section { padding: 25px 16px; }
h2 { text-align: center; color: #c62d76; }
.products {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(145px,1fr));
  gap: 16px;
  max-width: 1000px;
  margin: auto;
}
.card {
  background: white;
  border: 1px solid #ffe0ed;
  border-radius: 16px;
  padding: 16px;
  text-align: center;
  box-shadow: 0 3px 10px #00000008;
}
.emoji { font-size: 50px; }
.price { color: #c62d76; font-weight: bold; }
input, textarea {
  display: block;
  width: 100%;
  margin: 10px 0;
  padding: 12px;
  border: 1px solid #f1b7d0;
  border-radius: 10px;
  font: inherit;
}
form { max-width: 500px; margin: auto; }
#cart {
  max-width: 600px;
  margin: auto;
  background: white;
  padding: 18px;
  border-radius: 15px;
}
footer {
  padding: 25px;
  text-align: center;
  background: #ffe3ef;
}
.small { font-size: 13px; color: #775467; }
</style>
</head>
<body>

<header>
  <h1>💕 Angels Glow Hub 💕</h1>
  <p>Your glow, your beauty, your confidence!</p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#shop">Shop</a>
  <a href="#cart">Cart (<span id="count">0</span>)</a>
  <a href="#checkout">Order</a>
</nav>

<div class="hero" id="home">
  <h2>Welcome to Your Glow Era! ✨</h2>
  <p>Discover cute beauty essentials and accessories picked just for you.</p>
  <a href="#shop"><button>Shop Now 💗</button></a>
</div>

<section id="shop">
  <h2>Our Products 🛍️</h2>
  <div class="products" id="products"></div>
  <p class="small" style="text-align:center">
    Sample products and prices are shown. Update them to match your real stock.
  </p>
</section>

<section id="cart">
  <h2>Your Shopping Cart 🛒</h2>
  <div id="cartItems">Your cart is empty.</div>
  <h3>Total: <span id="total">₦0</span></h3>
  <button onclick="document.getElementById('checkout').scrollIntoView({behavior:'smooth'})">
    Proceed to Checkout
  </button>
</section>

<section id="checkout">
  <h2>Place Your Order 💌</h2>
  <form id="orderForm">
    <input id="customerName" placeholder="Your full name" required>
    <input id="phone" type="tel" placeholder="Your phone number" required>
    <textarea id="address" placeholder="Your delivery address" required></textarea>
    <textarea id="notes" placeholder="Extra instructions (optional)"></textarea>
    <button type="submit">Submit Order 💖</button>
    <p class="small">
      This initial version prepares an order summary on your device.
      Online order notifications must be connected separately.
    </p>
  </form>
  <div id="confirmation" role="status"></div>
</section>

<footer>
  <h3>Angels Glow Hub 💕</h3>
  <p>Thank you for shopping with us!</p>
  <p class="small">Beauty • Accessories • Confidence</p>
</footer>

<script>
const products = [
  {id:1,name:"Lip Gloss",price:1500,emoji:"💄"},
  {id:2,name:"Cute Bracelet",price:3500,emoji:"📿"},
  {id:3,name:"Beauty Essentials",price:2500,emoji:"🎀"},
  {id:4,name:"Girly Accessories",price:2000,emoji:"💗"}
];

let cart = [];

function naira(n) {
  return "₦" + n.toLocaleString("en-NG");
}

function renderProducts() {
  document.getElementById("products").innerHTML = products.map(p => `
    <article class="card">
      <div class="emoji">${p.emoji}</div>
      <h3>${p.name}</h3>
      <p class="price">${naira(p.price)}</p>
      <button onclick="addToCart(${p.id})">Add to Cart 🛒</button>
    </article>
  `).join("");
}

function addToCart(id) {
  const item = cart.find(p => p.id === id);
  if (item) item.qty++;
  else cart.push({...products.find(p => p.id === id),qty:1});
  renderCart();
}

function renderCart() {
  document.getElementById("count").textContent =
    cart.reduce((sum,p) => sum + p.qty,0);

  document.getElementById("cartItems").innerHTML = cart.length
    ? cart.map(p => `
      <p>${p.name} × ${p.qty} — ${naira(p.price*p.qty)}
      <button onclick="removeItem(${p.id})">Remove</button></p>
    `).join("")
    : "Your cart is empty.";

  document.getElementById("total").textContent =
    naira(cart.reduce((sum,p) => sum+p.price*p.qty,0));
}

function removeItem(id) {
  cart = cart.filter(p => p.id !== id);
  renderCart();
}

document.getElementById("orderForm").addEventListener("submit", function(e) {
  e.preventDefault();

  if (!cart.length) {
    alert("Please add at least one product to your cart first.");
    return;
  }

  const order = {
    name: document.getElementById("customerName").value.trim(),
    phone: document.getElementById("phone").value.trim(),
    address: document.getElementById("address").value.trim(),
    notes: document.getElementById("notes").value.trim(),
    items: cart.map(p => `${p.name} x ${p.qty}`).join(", "),
    total: naira(cart.reduce((sum,p) => sum+p.price*p.qty,0))
  };

  const message = [
    "NEW ANGELS GLOW HUB ORDER",
    "Name: " + order.name,
    "Phone: " + order.phone,
    "Address: " + order.address,
    "Items: " + order.items,
    "Total: " + order.total,
    "Notes: " + (order.notes || "None")
  ].join("\\n");

  document.getElementById("confirmation").innerHTML =
    "<p>Your order summary is ready! Choose how to send it to the shop owner.</p>";

  const link = document.createElement("a");
  link.href = "https://wa.me/?text=" + encodeURIComponent(message);
  link.target = "_blank";
  link.rel = "noopener noreferrer";
  link.textContent = "Send Order on WhatsApp 💚";
  link.style.cssText =
    "display:inline-block;background:#25a35a;color:white;padding:14px;border-radius:25px;text-decoration:none;font-weight:bold;margin-top:10px";

  document.getElementById("confirmation").appendChild(link);
});
renderProducts();
renderCart();
</script>

</body>
</html>
